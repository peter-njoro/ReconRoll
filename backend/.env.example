# Django Settings
DJANGO_MODE=dev
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgres://facetrack:facetrack@db:5432/facetrack_db
POSTGRES_USER=facetrack
POSTGRES_PASSWORD=facetrack
POSTGRES_DB=facetrack_db
DB_HOST=db
DB_PORT=5432

# API Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.100.90
CSRF_TRUSTED_ORIGINS=https://192.168.100.90,https://localhost:443,http://localhost:5173,http://192.168.100.90:5173
CORS_ALLOWED_ORIGINS=https://192.168.100.90,https://localhost:443,http://localhost:5173,http://192.168.100.90:5173

# Face Recognition Settings
FACE_MODEL=hog
SCALE=0.25
MIN_FACE_SIZE=100
TOLERANCE=0.55
FRAME_FORWARDER=false
PROCESS_EVERY_N_FRAMES=3
CARD_DISPLAY_FRAMES=10

# Display Configuration (for X11/Wayland)
DISPLAY_TYPE=x11
VIDEO_GID=983

# Frontend API Configuration
REACT_APP_API_URL=https://192.168.100.90/api
REACT_APP_API_TIMEOUT=30000
