# ============================================================
# backend/.env.prod.example
# Copy to .env.prod and fill in real values before deploying.
# NEVER commit .env.prod to version control.
# ============================================================

# --- Django ---
SECRET_KEY=must-be-set-for-production
DEBUG=False
DJANGO_MODE=production
DJANGO_SETTINGS_MODULE=config.settings

# Comma-separated list of allowed hostnames / IPs
ALLOWED_HOSTS=yourdomain.com,192.168.100.90

# Comma-separated — must use https:// in production
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --- Database (PostgreSQL) ---
POSTGRES_USER=facetrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=facetrack_db
DB_HOST=reconroll-db
DB_PORT=5432

# --- Face recognition tuning ---
FACE_MODEL=hog
SCALE=0.25
MIN_FACE_SIZE=100
TOLERANCE=0.55

# --- Frame forwarding (set true to start webcam stream on boot) ---
FRAME_FORWARDER=false

# --- Optional: superuser auto-creation ---
CREATE_SUPERUSER=false
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Encoding cache ---
ENCODING_CACHE_KEY=face_encodings
ENCODING_CACHE_TTL=600
